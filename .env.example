# Nexus Technology - Environment Variables
# Copy this to .env.local and fill in the values

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here
COMPANY_EMAIL=info.nexustech26@gmail.com

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Firebase — public web config (used for reading projects on the site).
# Get these from Firebase Console > Project settings > Your apps > SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — service account for secure server-side writes from /admin.
# Generate a private key (Project settings > Service accounts > Generate new
# private key), then base64-encode the whole JSON file into one line.
# See FIREBASE_SETUP.md for the exact command.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Admin panel password — the password you type at /admin/login.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Supabase (if using)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

